<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls">

    <SolidColorBrush x:Key="HighlightColor" Color="DarkGray"/>

    <Style xmlns:markup="http://schemas.microsoft.com/winfx/2006/xaml"
           x:Key="MyHighlightedSquareButtonStyle" TargetType="{markup:Type ButtonBase}"
           BasedOn="{StaticResource MahApps.Styles.Button.Square}">
        <Setter Property="Background" Value="{DynamicResource HighlightColor}"/>
        <Setter Property="mah:ControlsHelper.ContentCharacterCasing" Value="Normal"/>
    </Style>

    <Style xmlns:markup="http://schemas.microsoft.com/winfx/2006/xaml"
           x:Key="MyAccentedSquareButtonStyle" TargetType="{markup:Type ButtonBase}"
           BasedOn="{StaticResource MahApps.Styles.Button.Square.Accent}">
        <Setter Property="mah:ControlsHelper.ContentCharacterCasing" Value="Normal"/>
    </Style>

    <Style xmlns:markup="http://schemas.microsoft.com/winfx/2006/xaml"
           x:Key="MySquareButtonStyle" TargetType="{markup:Type ButtonBase}"
           BasedOn="{StaticResource MahApps.Styles.Button.Square}">
        <Setter Property="mah:ControlsHelper.ContentCharacterCasing" Value="Normal"/>
    </Style>

</ResourceDictionary>