  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <!--
    Costura only embeds files MSBuild hands it in @(ReferenceCopyLocalPaths), and Fody weaves at compile time, long
    before CreateSatelliteAssemblies has built this project's own es\SoundBoard.resources.dll. Without this, the
    single-file exe would silently contain only the neutral (English) strings. Pulling the satellites forward via
    Fody's own $(FodyDependsOnTargets) hook and adding them to @(ReferenceCopyLocalPaths) makes Costura embed them as
    costura.<culture>.soundboard.resources.dll.compressed, which its runtime assembly resolver then serves to
    ResourceManager. See BUILDING.md "Localization".
  -->
  <PropertyGroup>
    <FodyDependsOnTargets>$(FodyDependsOnTargets);EmbedOwnSatelliteAssemblies</FodyDependsOnTargets>
  </PropertyGroup>
  <ItemGroup>
    <!--
      A translation feeds only the satellite assembly, never the compiler, so editing one would leave CoreCompile (and
      with it Fody, and with it the embedded copy of the satellite) up to date: the exe would keep shipping the previous
      translation until something else forced a rebuild. Declaring the translations as compile inputs is the same trick
      Fody uses for FodyWeavers.xml.
    -->
    <CustomAdditionalCompileInputs Include="Properties\Resources.*.resx" />
  </ItemGroup>
  <Target Name="EmbedOwnSatelliteAssemblies" DependsOnTargets="CreateSatelliteAssemblies">
    <ItemGroup>
      <ReferenceCopyLocalPaths Include="@(IntermediateSatelliteAssembliesWithTargetPath->'%(FullPath)')" />
    </ItemGroup>
  </Target>
