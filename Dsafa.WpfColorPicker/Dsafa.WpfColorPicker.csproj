<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Vendored fork of WpfColorPicker 1.2.0 by Brandon Chong (MIT, see LICENSE), from
    https://github.com/dsafa/wpf-color-picker. It replaces the prebuilt (and already modified)
    Dsafa.WpfColorPicker.dll that used to live in SoundBoard\lib. See NOTICE.md for what differs
    from upstream.
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Dsafa.WpfColorPicker</RootNamespace>
    <AssemblyName>Dsafa.WpfColorPicker</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <Version>1.2.0</Version>
    <Product>WpfColorPicker</Product>
    <Copyright>Copyright © 2019 Brandon Chong</Copyright>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Drawing" />
  </ItemGroup>

</Project>
